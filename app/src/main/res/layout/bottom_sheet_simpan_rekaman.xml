<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp">
 
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SIMPAN REKAMAN"
        android:textColor="@color/waveid_primary"
        android:textSize="11sp"
        android:fontFamily="@font/space_grotesk"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:layout_marginBottom="12dp" />
 
    <EditText
        android:id="@+id/bsEtBrand"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:hint="Brand Chipset / Charger"
        android:textColorHint="@color/text_tertiary"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:fontFamily="@font/space_grotesk"
        android:background="@drawable/bg_card"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:inputType="text"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/bsEtModel"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:hint="Tipe Chipset (misal: HELIO G85, MT6765)"
        android:textColorHint="@color/text_tertiary"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:fontFamily="@font/space_grotesk"
        android:background="@drawable/bg_card"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:inputType="text"
        android:layout_marginBottom="6dp" />
 
    <EditText
        android:id="@+id/bsEtKondisi"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:hint="Kondisi (Bootloop, Normal...)"
        android:textColorHint="@color/text_tertiary"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:fontFamily="@font/space_grotesk"
        android:background="@drawable/bg_card"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:inputType="text"
        android:layout_marginBottom="6dp" />
 
    <EditText
        android:id="@+id/bsEtUsername"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:hint="Nama teknisi"
        android:textColorHint="@color/text_tertiary"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:fontFamily="@font/space_grotesk"
        android:background="@drawable/bg_card"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:inputType="text"
        android:layout_marginBottom="12dp" />
 
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">
 
        <TextView
            android:id="@+id/bsBtnBatal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="BATAL"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="@font/space_grotesk"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp" />
 
        <TextView
            android:id="@+id/bsBtnSimpan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="SIMPAN"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:fontFamily="@font/space_grotesk"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_card_waveid"
            android:clickable="true"
            android:focusable="true" />
 
    </LinearLayout>
 
</LinearLayout>