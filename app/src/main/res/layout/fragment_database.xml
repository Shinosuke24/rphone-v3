<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050810">

    <!-- TOP BAR (36dp) -->
    <LinearLayout
        android:id="@+id/topBarDatabase"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#080C14"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_badge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R-PHONE V3"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:fontFamily="@font/rajdhani_bold"
            android:layout_marginStart="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_nav_active_waveid"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="DATABASE"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:fontFamily="@font/rajdhani_bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>

    <View
        android:id="@+id/topBarDividerDb"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#0D1423"
        app:layout_constraintTop_toBottomOf="@id/topBarDatabase" />

    <!-- CONTAINER (2 kolom) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/topBarDividerDb"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- KOLOM KIRI (weight 0.38) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.38"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Search Bar -->
            <EditText
                android:id="@+id/etCari"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:background="@drawable/bg_metric_card"
                android:hint="Cari brand / model..."
                android:textColorHint="#334155"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:fontFamily="@font/rajdhani_regular"
                android:paddingHorizontal="12dp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tvInfoDb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Memuat..."
                android:textColor="#64748B"
                android:textSize="11sp"
                android:fontFamily="@font/rajdhani_regular"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                
                <TextView
                    android:id="@+id/btnMultiSelect"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_metric_card"
                    android:gravity="center"
                    android:text="PILIH"
                    android:textColor="#F59E0B"
                    android:textSize="10sp"
                    android:fontFamily="@font/rajdhani_bold"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnShareTerpilih"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.5"
                    android:background="@drawable/bg_metric_card"
                    android:gravity="center"
                    android:text="SHARE (0)"
                    android:textColor="#10B981"
                    android:textSize="10sp"
                    android:fontFamily="@font/rajdhani_bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">
                
                <TextView
                    android:id="@+id/btnBackup"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_metric_card"
                    android:gravity="center"
                    android:text="BACKUP"
                    android:textColor="#10B981"
                    android:textSize="10sp"
                    android:fontFamily="@font/rajdhani_bold"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnRestore"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_metric_card"
                    android:gravity="center"
                    android:text="RESTORE"
                    android:textColor="#00D4FF"
                    android:textSize="10sp"
                    android:fontFamily="@font/rajdhani_bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnImportZip"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_metric_card"
                android:gravity="center"
                android:text="⬇ IMPORT .ZIP"
                android:textColor="#10B981"
                android:textSize="11sp"
                android:fontFamily="@font/rajdhani_bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnSyncServer"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_metric_card"
                android:gravity="center"
                android:text="☁ SYNC DARI SERVER"
                android:textColor="#00D4FF"
                android:textSize="11sp"
                android:fontFamily="@font/rajdhani_bold"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- KOLOM KANAN (weight 0.62) -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.62"
            android:padding="10dp">
            <LinearLayout
                android:id="@+id/listProfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>