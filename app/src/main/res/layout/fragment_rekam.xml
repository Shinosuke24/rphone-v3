<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050810">

    <!-- TOP BAR (36dp) -->
    <LinearLayout
        android:id="@+id/topBarRekam"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#080C14"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_badge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R-PHONE V3"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:fontFamily="@font/rajdhani_bold"
            android:layout_marginStart="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_nav_active_waveid"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="REKAM"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:fontFamily="@font/rajdhani_bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Chronometer
            android:id="@+id/chronometerRekam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:includeFontPadding="false"
            android:layout_marginEnd="10dp" />
    </LinearLayout>

    <View
        android:id="@+id/topBarDividerRekam"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#0D1423"
        app:layout_constraintTop_toBottomOf="@id/topBarRekam" />

    <!-- CONTAINER (2 kolom) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/topBarDividerRekam"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- KOLOM KIRI (weight 0.38) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.38"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Card Status Rekam -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_metric_card"
                android:padding="10dp"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:id="@+id/tvStatusRekam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="○ SIAP REKAM"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:fontFamily="@font/rajdhani_bold" />
                <TextView
                    android:id="@+id/tvJumlahSampel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 sampel"
                    android:textColor="#334155"
                    android:textSize="10sp"
                    android:fontFamily="@font/rajdhani_regular"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- btnSiapRekam -->
            <TextView
                android:id="@+id/btnSiapRekam"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_action_waveid"
                android:gravity="center"
                android:text="● SIAP REKAM"
                android:textColor="#10B981"
                android:textSize="15sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:fontFamily="@font/rajdhani_bold"
                android:layout_marginBottom="6dp" />

            <!-- Tombol Baris: Selesai + Jeda -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnSelesaiRekam"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_metric_card"
                    android:gravity="center"
                    android:text="■ SELESAI"
                    android:textColor="#EF4444"
                    android:textSize="13sp"
                    android:fontFamily="@font/rajdhani_bold"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone"
                    tools:visibility="visible" />
                <TextView
                    android:id="@+id/btnJedaRekam"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_metric_card"
                    android:gravity="center"
                    android:text="⏸ JEDA"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:fontFamily="@font/rajdhani_semibold"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <!-- KOLOM KANAN (weight 0.62) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.62"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Live Metrics Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal">
                <!-- ARUS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_metric_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="4dp">
                    <TextView
                        android:id="@+id/tvLiveArus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.000"
                        android:textColor="#10B981"
                        android:textSize="16sp"
                        android:fontFamily="@font/jetbrains_mono_bold"
                        android:includeFontPadding="false" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ARUS (A)"
                        android:textColor="#64748B"
                        android:textSize="8sp"
                        android:fontFamily="@font/rajdhani_regular" />
                </LinearLayout>
                <!-- TEGANGAN -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_metric_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="4dp">
                    <TextView
                        android:id="@+id/tvLiveTegangan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:textColor="#E2E8F0"
                        android:textSize="16sp"
                        android:fontFamily="@font/jetbrains_mono_bold"
                        android:includeFontPadding="false" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEGANGAN (V)"
                        android:textColor="#64748B"
                        android:textSize="8sp"
                        android:fontFamily="@font/rajdhani_regular" />
                </LinearLayout>
                <!-- PUNCAK -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_metric_card"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/tvLivePeak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.000"
                        android:textColor="#EF4444"
                        android:textSize="16sp"
                        android:fontFamily="@font/jetbrains_mono_bold"
                        android:includeFontPadding="false" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PUNCAK (A)"
                        android:textColor="#64748B"
                        android:textSize="8sp"
                        android:fontFamily="@font/rajdhani_regular" />
                </LinearLayout>
            </LinearLayout>

            <!-- Waveform -->
            <com.rphone.v3.view.WaveformView
                android:id="@+id/waveformRekam"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chart_area"
                android:layerType="software" />

            <!-- Fase Aktif -->
            <TextView
                android:id="@+id/tvFaseAktif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fase: —"
                android:textColor="#10B981"
                android:textSize="10sp"
                android:fontFamily="@font/rajdhani_semibold"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>