<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050810">

    <!-- Glow ring di belakang logo -->
    <View
        android:id="@+id/viewGlowRing"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/splash_glow_ring"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/dividerCenter"
        app:layout_constraintVertical_bias="0.5" />

    <!-- Logo PNG -->
    <ImageView
        android:id="@+id/ivSplashIcon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo"
        android:scaleType="fitCenter"
        android:contentDescription="R-Phone Logo"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/dividerCenter"
        app:layout_constraintVertical_bias="0.5" />

    <!-- Divider invisible sebagai anchor tengah -->
    <View
        android:id="@+id/dividerCenter"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="0dp" />

    <!-- Title R-PHONE V3 -->
    <TextView
        android:id="@+id/tvSplashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="R-PHONE V3"
        android:textColor="#E2E8F0"
        android:textSize="38sp"
        android:fontFamily="@font/rajdhani_bold"
        android:letterSpacing="0.12"
        android:alpha="0"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toTopOf="@id/tvSplashSubtitle"
        app:layout_constraintStart_toEndOf="@id/dividerCenter"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="32dp" />

    <!-- Subtitle POWER MONITOR -->
    <TextView
        android:id="@+id/tvSplashSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="POWER MONITOR"
        android:textColor="#00D4FF"
        android:textSize="13sp"
        android:fontFamily="@font/rajdhani_semibold"
        android:letterSpacing="0.25"
        android:alpha="0"
        android:includeFontPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/dividerCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5"
        android:layout_marginStart="32dp" />

    <!-- Version tag badge -->
    <TextView
        android:id="@+id/tvSplashVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ESP32 + INA3221"
        android:textColor="#334155"
        android:textSize="10sp"
        android:fontFamily="@font/jetbrains_mono_regular"
        android:letterSpacing="0.08"
        android:alpha="0"
        android:includeFontPadding="false"
        android:layout_marginTop="10dp"
        android:layout_marginStart="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvSplashSubtitle"
        app:layout_constraintStart_toEndOf="@id/dividerCenter"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scan line overlay -->
    <View
        android:id="@+id/viewScanLine"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#1400D4FF"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Progress bar tipis di bawah -->
    <ProgressBar
        android:id="@+id/progressSplash"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:progressTint="#00D4FF"
        android:progressBackgroundTint="#0D1423"
        android:max="100"
        android:progress="0"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- OVERLAY UPDATE APP (FORCE — tidak ada tombol Nanti)        -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/overlayUpdate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#EE050810"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔"
            android:textSize="36sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPDATE WAJIB TERSEDIA"
            android:textColor="#00D4FF"
            android:textSize="18sp"
            android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.15"
            android:layout_marginBottom="4dp" />

        <!-- Versi baru -->
        <TextView
            android:id="@+id/tvUpdateVersi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.0"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:fontFamily="@font/jetbrains_mono_regular"
            android:layout_marginBottom="8dp" />

        <!-- Info wajib update -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aplikasi harus diperbarui untuk dapat digunakan"
            android:textColor="#7C3AED"
            android:textSize="11sp"
            android:fontFamily="@font/rajdhani_regular"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Card changelog -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0D1423"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHANGELOG"
                android:textColor="#334155"
                android:textSize="9sp"
                android:fontFamily="@font/rajdhani_semibold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvUpdateChangelog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:fontFamily="@font/rajdhani_regular"
                android:lineSpacingMultiplier="1.5" />
        </LinearLayout>

        <!-- Tombol Download (satu-satunya pilihan) -->
        <TextView
            android:id="@+id/btnDownloadUpdate"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="⬇  DOWNLOAD &amp; UPDATE SEKARANG"
            android:textColor="#050810"
            android:textSize="13sp"
            android:fontFamily="@font/rajdhani_bold"
            android:textAllCaps="true"
            android:background="#00D4FF" />

        <!-- TIDAK ADA btnUpdateNanti — force update -->

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- OVERLAY DOWNLOADING APK (default GONE)                     -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/overlayDownloading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#EE050810"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="32dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">
            <View android:id="@+id/dot1" android:layout_width="10dp" android:layout_height="10dp"
                android:background="#00D4FF" android:layout_marginEnd="6dp" android:alpha="0.3" />
            <View android:id="@+id/dot2" android:layout_width="10dp" android:layout_height="10dp"
                android:background="#00D4FF" android:layout_marginEnd="6dp" android:alpha="0.3" />
            <View android:id="@+id/dot3" android:layout_width="10dp" android:layout_height="10dp"
                android:background="#00D4FF" android:alpha="0.3" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MENGUNDUH UPDATE"
            android:textColor="#00D4FF"
            android:textSize="14sp"
            android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.15"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvDownloadPersen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#E2E8F0"
            android:textSize="36sp"
            android:fontFamily="@font/jetbrains_mono_bold"
            android:includeFontPadding="false"
            android:layout_marginBottom="20dp" />

        <ProgressBar
            android:id="@+id/pbDownloadOta"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#00D4FF"
            android:progressBackgroundTint="#0D1423"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvDownloadKeterangan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menyiapkan file..."
            android:textColor="#334155"
            android:textSize="11sp"
            android:fontFamily="@font/rajdhani_regular" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- OVERLAY FIRMWARE UPDATE (default GONE)                     -->
    <!-- Ditampilkan dari MainActivity setelah BT/OTG konek        -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- OVERLAY DOWNLOAD GAGAL — Coba Lagi (default GONE)         -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/overlayDownloadFailed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#EE050810"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="36sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DOWNLOAD GAGAL"
            android:textColor="#EF4444"
            android:textSize="18sp"
            android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.15"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pastikan koneksi internet tersedia\nlalu coba lagi"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:fontFamily="@font/rajdhani_regular"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Tombol Coba Lagi (tidak ada tombol Lanjut) -->
        <TextView
            android:id="@+id/btnCobaLagi"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="↺  COBA LAGI"
            android:textColor="#050810"
            android:textSize="13sp"
            android:fontFamily="@font/rajdhani_bold"
            android:textAllCaps="true"
            android:background="#EF4444" />

    </LinearLayout>


    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- OVERLAY SENSOR CHECK — Futuristic BT Scanner               -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/overlaySensorCheck"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="#F0050810"
        android:visibility="gone"
        android:fitsSystemWindows="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ══ PANEL KIRI: Scan Radar ══ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="16dp">

            <!-- Corner brackets top-left -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[ BT SCANNER v3.3 ]"
                android:textSize="9sp"
                android:textColor="#1A00D9FF"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:letterSpacing="0.15"
                android:layout_marginBottom="8dp" />

            <!-- Radar container -->
            <FrameLayout
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp">

                <!-- Ring 3 outermost -->
                <View
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:background="@drawable/splash_glow_ring"
                    android:alpha="0.3" />

                <!-- Ring 2 -->
                <View
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_gravity="center"
                    android:background="@drawable/splash_glow_ring"
                    android:alpha="0.5" />

                <!-- Ring 1 innermost -->
                <View
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:background="@drawable/splash_glow_ring"
                    android:alpha="0.8" />

                <!-- Cross H line -->
                <View
                    android:layout_width="160dp"
                    android:layout_height="1dp"
                    android:layout_gravity="center"
                    android:background="#0A00D9FF" />

                <!-- Cross V line -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:background="#0A00D9FF" />

                <!-- BT Icon center -->
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="#14050810">

                    <ImageView
                        android:id="@+id/ivScannerIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bluetooth"
                        app:tint="#00D9FF"
                        android:alpha="1.0" />
                </FrameLayout>

            </FrameLayout>

            <!-- Status line -->
            <TextView
                android:id="@+id/tvSensorStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INITIALIZING..."
                android:textSize="11sp"
                android:textColor="#00D9FF"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <!-- Scan progress bar -->
            <ProgressBar
                android:id="@+id/pbSensorCheck"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:indeterminate="true"
                android:progressTint="#00D9FF"
                android:progressBackgroundTint="#0D00D9FF"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- Scan button -->
            <TextView
                android:id="@+id/btnSensorHubungkan"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⟫  SCAN BLUETOOTH"
                android:textSize="12sp"
                android:textColor="#050810"
                android:fontFamily="@font/jetbrains_mono_medium"
                android:letterSpacing="0.1"
                android:background="#00D9FF"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />

        </LinearLayout>

        <!-- ── Vertical divider ── -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#0D00D9FF" />

        <!-- ══ PANEL KANAN: Device List ══ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <!-- Header bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:background="#00D9FF"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PERANGKAT TERDETEKSI"
                    android:textSize="10sp"
                    android:textColor="#00D9FF"
                    android:fontFamily="@font/jetbrains_mono_regular"
                    android:letterSpacing="0.15" />

                <!-- Device count badge -->
                <TextView
                    android:id="@+id/tvDeviceCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="10sp"
                    android:textColor="#050810"
                    android:fontFamily="@font/jetbrains_mono_medium"
                    android:background="#00D9FF"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp" />

            </LinearLayout>

            <!-- Top divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1400D9FF"
                android:layout_marginBottom="4dp" />

            <!-- Device list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBtDevices"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="4dp" />

            <!-- Bottom: system info -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#0A00D9FF"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="R-PHONE V3  ◆  ESP32_PowerMonitor  ◆  BT SPP"
                android:textSize="8sp"
                android:textColor="#1E293B"
                android:fontFamily="@font/jetbrains_mono_regular"
                android:letterSpacing="0.05"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>