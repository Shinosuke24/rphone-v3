<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow layer -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A3B82F6" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Border biru -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#0D1423" />
            <stroke android:width="1dp" android:color="#3B82F6" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>